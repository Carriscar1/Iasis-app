{
  "expo": {
    "name": "IASIS",
    "slug": "iasis",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "iasis",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C2B4B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iasis.app"
    },
    "android": {
      "versionCode": 6,
      "package": "com.iasis.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C2B4B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CALL_PHONE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1C2B4B"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O IASIS usa a câmera para a sua foto de perfil e para ler o código de barras da caixa do remédio."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O IASIS acessa suas fotos para você escolher uma imagem de perfil.",
          "cameraPermission": "O IASIS usa a câmera para tirar a sua foto de perfil."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "O IASIS lê seus contatos apenas neste aparelho, para você escolher um cuidador sem digitar o número."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O IASIS envia sua localização aos cuidadores quando você aciona a emergência."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://qoqlsymvmmmsfsfscpmg.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFvcWxzeW12bW1tc2ZzZnNjcG1nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzNjg2NzcsImV4cCI6MjA5Nzk0NDY3N30.rzRMUUXXtXG5AWFsX61reOIU1oY-IjmJVvrZCgfTnjk",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9b88ae50-ba18-4b45-8beb-1e189b26c07e"
      }
    },
    "owner": "carriscar"
  }
}
